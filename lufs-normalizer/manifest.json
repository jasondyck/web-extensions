{
  "manifest_version": 3,
  "name": "Loudness Normalizer",
  "version": "1.1.0",
  "description": "Normalizes audio and video on any site to a target loudness (LUFS).",
  "browser_specific_settings": {
    "gecko": {
      "id": "lufs-normalizer@jason",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["storage"],
  "icons": { "48": "icons/icon.svg", "96": "icons/icon.svg" },
  "action": { "default_popup": "popup.html", "default_icon": "icons/icon.svg", "default_title": "Loudness Normalizer" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["defaults.js", "content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
